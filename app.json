{
  "expo": {
    "name": "ZoologicoBrasilia",
    "slug": "ZoologicoBrasilia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/images/icon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
